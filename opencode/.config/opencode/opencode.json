{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "ustc": {
      "name": "ustc",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.llm.ustc.edu.cn/v1/"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek Flash",
          "limit": {
            "context": 1000000
          }
        },
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash",
          "limit": {
            "context": 1000000
          },
          "capabilities": {
            "tools": true,
            "reasoning": {
              "supported": true
            }
          }
        }
      }
    }
  },
  "skills": [
    "~/.config/opencode/academic-research-skills/skills"
  ],
  "mcp": {
    "servers": {
      "zotero": {
        "type": "local",
        "command": ["zotero-mcp"],
        "disabled": true,
        "environment": {
          "ZOTERO_LOCAL": "true"
        }
      }
    }
  },
  "plugins": [
    "@cortexkit/opencode-magic-context@latest"
  ],
  "compaction": {
    "auto": false,
    "prune": false
  }
}
